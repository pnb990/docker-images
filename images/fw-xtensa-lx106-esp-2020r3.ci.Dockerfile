# Generated by src/main.py from config/default/config.yaml.
# Do not edit by hand: edit ressources/templates/ and regenerate.
#
# image    : fw-xtensa-lx106-esp-2020r3
# variant  : ci
# features : locale -> systemd -> git -> build -> python -> uv -> xtensa-lx106 -> ci-runtime -> clang

FROM debian:trixie-slim

# -------------------------------------------------------------------
# feature: locale
# -------------------------------------------------------------------
# Kept first in every variant of every image, followed by `systemd`: they are
# the layers all the images share, so they must be identical everywhere.
RUN apt-get update && apt-get install -y --no-install-recommends \
        locales \
    && sed -i \
        -e '/en_US.UTF-8/s/^# //g' \
        -e '/fr_FR.UTF-8/s/^# //g' \
        /etc/locale.gen \
    && locale-gen \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# -------------------------------------------------------------------
# feature: systemd
# -------------------------------------------------------------------
# Installed, not running: systemd is not PID 1 here, so nothing starts and
# the containers behave as before. What it brings is the tooling every
# distribution now relies on: systemctl, systemd-analyze, systemd-sysusers and
# systemd-tmpfiles. A package's maintainer scripts find them (a unit's start
# is skipped, since /run/systemd/system does not exist), and a test can check
# its units with `systemd-analyze verify` and `systemctl is-enabled`. Running
# it as PID 1 is soft-lib/docker-images#31.
#
# Right after `locale` in every variant of every image, so that every image
# shares it: about 20 MB, cheaper than finding out later which ones need it.
#
# The install generates an /etc/machine-id, which would be baked into the
# image and shared by every container. Emptied, as the Debian images ship it:
# an empty file means "not initialised yet".
RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && : > /etc/machine-id

# -------------------------------------------------------------------
# feature: git
# -------------------------------------------------------------------
# A newer git (>= 2.48), for relative-path git worktree linking: worktrees
# keep working when the whole tree is relocated (e.g. the repo is bind-mounted
# at a different path in a container, or checked out by the CI). Debian
# trixie ships git 2.47, which lacks it, so it comes from the
# soft-lib/git-backport package. Right after `systemd` in every variant of
# every image; a feature that lists `git` later finds it already installed.
#
# The .deb files are fetched directly, not through an apt source: outside the
# server's network the registry requires a client certificate, so a source
# left in the image would break every later `apt-get update`. Without apt's
# signature check, the sha256 pins stand in for it; a new git is an image
# bump. `apt-get install ./*.deb` pulls the dependencies from Debian.
ARG GIT_DEB_VERSION=1:2.53.0-1~bpo13+1
ARG GIT_DEB_SHA256=dc0a75e630c5a619bcb1ce983e357ba34a43b63e91a1e9774f7e75807e716822
ARG GIT_MAN_DEB_SHA256=5f615725a15a1bba0ca476eb0fedbd8649dfa986e7c57b4119bee83225924429

RUN [ "$(dpkg --print-architecture)" = amd64 ] \
        || { echo "the git backport is only published for amd64" >&2; exit 1; } \
    && apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && POOL=https://gitbtv.ddns.net/api/packages/soft-lib/debian/pool/trixie/main \
    && cd /tmp \
    && curl -fsSL -o git.deb "${POOL}/git_${GIT_DEB_VERSION}_amd64.deb" \
    && curl -fsSL -o git-man.deb "${POOL}/git-man_${GIT_DEB_VERSION}_all.deb" \
    && printf '%s  %s\n' "${GIT_DEB_SHA256}" git.deb "${GIT_MAN_DEB_SHA256}" git-man.deb \
        | sha256sum -c - \
    && apt-get install -y --no-install-recommends ./git.deb ./git-man.deb \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/git.deb /tmp/git-man.deb \
    && git --version | grep -q '^git version 2\.53\.'

# -------------------------------------------------------------------
# feature: build
# -------------------------------------------------------------------
# make, cmake and ninja are carried by every firmware variant, including the
# ones that do not use them: a few tens of MB against the 1.2 GB toolchain,
# not worth a separate variant.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        wget \
        bzip2 \
        ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------------
# feature: python
# -------------------------------------------------------------------
# The system interpreter, for scripts that expect /usr/bin/python3. Project
# environments are uv's job, hence no pip and no pipenv here.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------------
# feature: uv
# -------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# wget, not curl: curl is only present in the dev variant. Piping the
# installer into sh would also hide a download failure, so download it, run
# it, then check that uv really is there.
RUN wget -qO /tmp/uv-install.sh https://astral.sh/uv/install.sh \
    && env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 \
        sh /tmp/uv-install.sh \
    && rm /tmp/uv-install.sh \
    && uv --version

# -------------------------------------------------------------------
# feature: xtensa-lx106
# -------------------------------------------------------------------
# ESP8266 firmware: Espressif's xtensa-lx106-elf toolchain plus
# ESP8266_RTOS_SDK, both pinned. Espressif only publishes the toolchain for
# x86 hosts, hence the explicit architecture check.
#
# The SDK's last tag (v3.4) dates from 2021 while master still receives
# fixes, so it is pinned by commit, like every other pin of these images.
# The checksum is the one the SDK itself declares in tools/tools.json.
ARG XTENSA_TOOLCHAIN_VERSION=gcc8_4_0-esp-2020r3
ARG XTENSA_TOOLCHAIN_SHA256=0a1804b5e2231c6db8b72af6bc2a0f9a5b6994cfba29956d412651109f13fe7e
ARG ESP8266_RTOS_SDK_COMMIT=858c7c2eb9004691f2c736c64a23715f6ea900c4
ARG ESP8266_SDK_PYTHON=3.13

ENV XTENSA_TOOLCHAIN_DIR=/opt/xtensa-lx106-elf/${XTENSA_TOOLCHAIN_VERSION}
ENV IDF_PATH=/opt/esp8266-rtos-sdk
ENV IDF_PYTHON_ENV_PATH=/opt/esp8266-rtos-sdk-venv
ENV PATH=${XTENSA_TOOLCHAIN_DIR}/bin:$PATH

# flex, bison, gperf and ncurses build the SDK's mconf, for `idf.py
# menuconfig`; a plain build does not need them.
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
        git \
        flex \
        bison \
        gperf \
        libncurses-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN [ "$(dpkg --print-architecture)" = amd64 ] \
        || { echo "xtensa-lx106-elf is only published for amd64" >&2; exit 1; } \
    && TARBALL="xtensa-lx106-elf-${XTENSA_TOOLCHAIN_VERSION}-linux-amd64.tar.gz" \
    && cd /tmp \
    && wget -q "https://dl.espressif.com/dl/${TARBALL}" \
    && echo "${XTENSA_TOOLCHAIN_SHA256}  ${TARBALL}" | sha256sum -c - \
    && mkdir -p ${XTENSA_TOOLCHAIN_DIR} \
    && tar -xzf "${TARBALL}" -C ${XTENSA_TOOLCHAIN_DIR} \
        --strip-components=1 --no-same-owner \
    && rm -f "${TARBALL}" \
    && xtensa-lx106-elf-gcc --version

# Shallow fetch of the one pinned commit.
#
# The SDK compiles its version (IDF_VER, what esp_get_idf_version() returns)
# from version.txt when present, else from `git describe`, which fails here
# twice: the clone has no tag, and the tree belongs to root while builds run
# as `dev`, which git refuses ("dubious ownership"). The firmware then
# reported "-128-NOTFOUND". version.txt names the pinned commit instead, and
# safe.directory keeps the SDK's other git calls (submodule check) working
# for any user. '*' rather than the SDK path: each submodule is a repository
# of its own, and a build image has no other user to protect against.
RUN git init -q ${IDF_PATH} \
    && cd ${IDF_PATH} \
    && git remote add origin https://github.com/espressif/ESP8266_RTOS_SDK.git \
    && git fetch -q --depth 1 origin ${ESP8266_RTOS_SDK_COMMIT} \
    && git checkout -q FETCH_HEAD \
    && git submodule update -q --init --recursive --depth 1 \
    && echo "master-$(git rev-parse --short=12 HEAD)" > version.txt \
    && git config --system --add safe.directory '*'

# The SDK's python tooling gets its own interpreter, a uv-managed one, so
# that it neither depends on nor breaks with Debian's python3. Its
# requirements pin old packages (cryptography<35, pyparsing<2.4) that still
# install on 3.13; setuptools<80 is the one extra pin, the SDK imports
# pkg_resources, which setuptools 80 removed.
RUN UV_PYTHON_INSTALL_DIR=/opt/uv-python \
        uv venv -q --python ${ESP8266_SDK_PYTHON} \
        --python-preference only-managed ${IDF_PYTHON_ENV_PATH} \
    && uv pip install -q --python ${IDF_PYTHON_ENV_PATH} \
        -r ${IDF_PATH}/requirements.txt "setuptools<80" pip

# idf.py runs on that interpreter whatever python3 is first on PATH, and
# hands it to cmake through $PYTHON, so a project's own uv environment and
# the SDK's never mix.
RUN printf '#!/bin/sh\nexec "%s/bin/python" "%s/tools/idf.py" "$@"\n' \
        ${IDF_PYTHON_ENV_PATH} ${IDF_PATH} > /usr/local/bin/idf.py \
    && chmod 0755 /usr/local/bin/idf.py

# Proves the whole chain (toolchain, SDK, interpreter, cmake, ninja) before
# the image is published: an image that cannot build hello_world, or whose
# firmware does not carry the SDK version, is not pushed.
RUN cp -r ${IDF_PATH}/examples/get-started/hello_world /tmp/hello_world \
    && cd /tmp/hello_world \
    && idf.py build > /tmp/hello_world.log 2>&1 \
        || { tail -50 /tmp/hello_world.log; exit 1; } \
    && ls -l build/hello-world.bin \
    && grep -qaF "$(cat ${IDF_PATH}/version.txt)" build/hello-world.bin \
        || { echo "IDF_VER missing from the firmware" >&2; exit 1; } \
    && rm -rf /tmp/hello_world /tmp/hello_world.log

# -------------------------------------------------------------------
# feature: ci-runtime
# -------------------------------------------------------------------
# What the Forgejo runner needs to execute a job inside this image, not what
# the projects need to build. The runner runs the JavaScript actions
# (actions/checkout and friends) with the node of the container, and clones
# over ssh, hence node, git and openssh-client.
# `file` is there for libmagic: reuse depends on it, and a REUSE lint is a CI
# job like any other.
RUN apt-get update && apt-get install -y --no-install-recommends \
        nodejs \
        npm \
        git \
        openssh-client \
        curl \
        ca-certificates \
        file \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------------
# feature: clang
# -------------------------------------------------------------------
# clang and its tooling (clang-tidy, clangd, clang-format), for the C
# images: CI lints with them, and the editors of a devcontainer use the same
# versions. `bear`, in `dev`, records the compile commands these tools read.
#
# From apt.llvm.org, not Debian: trixie ships LLVM 19, and the projects'
# .clang-format use options of clang-format 20 and later (BinPackParameters:
# OnePerLine). The versioned binaries are linked under their plain names in
# /usr/local/bin, which precedes /usr/bin on PATH.
#
# Stacked right after `ci-runtime`, before `dev`, so it runs as root and
# `ci` stays a prefix of every dev-derived variant.
ARG CLANG_VERSION=21

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
        -o /etc/apt/keyrings/apt.llvm.org.asc \
    && . /etc/os-release \
    && echo "deb [signed-by=/etc/apt/keyrings/apt.llvm.org.asc]" \
        "http://apt.llvm.org/${VERSION_CODENAME}/" \
        "llvm-toolchain-${VERSION_CODENAME}-${CLANG_VERSION} main" \
        > /etc/apt/sources.list.d/apt.llvm.org.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        clang-${CLANG_VERSION} \
        clang-tidy-${CLANG_VERSION} \
        clang-format-${CLANG_VERSION} \
        clangd-${CLANG_VERSION} \
    && for tool in clang clang++ clang-tidy clang-format clangd; do \
        ln -sf "/usr/bin/${tool}-${CLANG_VERSION}" "/usr/local/bin/${tool}"; \
    done \
    && clang-format --version \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------------
# provenance
# -------------------------------------------------------------------
# Kept last in every image: IMAGE_COMMIT changes at every build, and an ARG
# read by a RUN invalidates that layer and everything after it. Last means
# the only rebuilt layer is this one, a few bytes.
#
# Written to a file, not only to a LABEL: a job running inside the container
# can read a file, it cannot read the labels of its own image. This is what
# makes a floating tag traceable -- the log of a green run says exactly which
# commit to pin when that build has to be rolled back to.
#
# /etc/image-info, and the shape of os-release and machine-info: quoted
# KEY="value" lines, so the file is both readable with `cat` and sourceable
# with `. /etc/image-info`. Not /etc/*-release, which is the legacy
# distro-identification pile os-release was written to replace, and not
# os-release itself -- that is a symlink into /usr/lib owned by the base
# distribution, and appending to it means either editing the vendor's file or
# breaking the link.
#
# The keys are prefixed. A bare COMMIT= would collide with a local of whatever
# script sources this. IMAGE_ID and IMAGE_VERSION are avoided on purpose: they
# are os-release spec names with defined meanings, and borrowing them for
# something else is worse than not using them.
ARG IMAGE_COMMIT=unknown
# The commit's own date, RFC 3339, not the build time -- a build time would
# change on every rebuild and destroy the property IMAGE_COMMIT exists for.
# It is here because a hash has no order: it answers "which build is this",
# never "is this older than what I have pinned". The image tag carries the
# same date in its compact YYYYMMDD form, which is what makes two pins
# comparable by eye; this one is the full value, so that
# org.opencontainers.image.created below is what the OCI spec says it is.
ARG IMAGE_DATE=unknown
LABEL org.opencontainers.image.revision="$IMAGE_COMMIT"
LABEL org.opencontainers.image.created="$IMAGE_DATE"
RUN printf 'IMAGE_NAME="%s"\nIMAGE_VARIANT="%s"\nIMAGE_COMMIT="%s"\nIMAGE_DATE="%s"\n' \
        'fw-xtensa-lx106-esp-2020r3' 'ci' "$IMAGE_COMMIT" "$IMAGE_DATE" \
        > /etc/image-info
