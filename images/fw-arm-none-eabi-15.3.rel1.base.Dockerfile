# Generated by src/main.py from config/default/config.yaml.
# Do not edit by hand: edit ressources/templates/ and regenerate.
#
# image    : fw-arm-none-eabi-15.3.rel1
# variant  : base
# features : locale -> systemd -> git -> build -> python -> uv -> arm-15.3.rel1

FROM debian:trixie-slim

# -------------------------------------------------------------------
# feature: locale
# -------------------------------------------------------------------
# Kept first in every variant of every image, followed by `systemd`: they are
# the layers all the images share, so they must be identical everywhere.
RUN apt-get update && apt-get install -y --no-install-recommends \
        locales \
    && sed -i \
        -e '/en_US.UTF-8/s/^# //g' \
        -e '/fr_FR.UTF-8/s/^# //g' \
        /etc/locale.gen \
    && locale-gen \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# -------------------------------------------------------------------
# feature: systemd
# -------------------------------------------------------------------
# Installed, not running: systemd is not PID 1 here, so nothing starts and
# the containers behave as before. What it brings is the tooling every
# distribution now relies on: systemctl, systemd-analyze, systemd-sysusers and
# systemd-tmpfiles. A package's maintainer scripts find them (a unit's start
# is skipped, since /run/systemd/system does not exist), and a test can check
# its units with `systemd-analyze verify` and `systemctl is-enabled`. Running
# it as PID 1 is soft-lib/docker-images#31.
#
# Right after `locale` in every variant of every image, so that every image
# shares it: about 20 MB, cheaper than finding out later which ones need it.
#
# The install generates an /etc/machine-id, which would be baked into the
# image and shared by every container. Emptied, as the Debian images ship it:
# an empty file means "not initialised yet".
RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && : > /etc/machine-id

# -------------------------------------------------------------------
# feature: git
# -------------------------------------------------------------------
# A newer git (>= 2.48), for relative-path git worktree linking: worktrees
# keep working when the whole tree is relocated (e.g. the repo is bind-mounted
# at a different path in a container, or checked out by the CI). Debian
# trixie ships git 2.47, which lacks it, so it comes from the
# soft-lib/git-backport package. Right after `systemd` in every variant of
# every image; a feature that lists `git` later finds it already installed.
#
# The .deb files are fetched directly, not through an apt source: outside the
# server's network the registry requires a client certificate, so a source
# left in the image would break every later `apt-get update`. Without apt's
# signature check, the sha256 pins stand in for it; a new git is an image
# bump. `apt-get install ./*.deb` pulls the dependencies from Debian.
#
# GIT_DEB_POOL is overridden by build-images with the runner's own server URL
# (plain http on the LAN): the public URL asks the builder for that client
# certificate too.
ARG GIT_DEB_POOL=https://gitbtv.ddns.net/api/packages/soft-lib/debian/pool/trixie/main
ARG GIT_DEB_VERSION=1:2.53.0-1~bpo13+1
ARG GIT_DEB_SHA256=dc0a75e630c5a619bcb1ce983e357ba34a43b63e91a1e9774f7e75807e716822
ARG GIT_MAN_DEB_SHA256=5f615725a15a1bba0ca476eb0fedbd8649dfa986e7c57b4119bee83225924429

RUN [ "$(dpkg --print-architecture)" = amd64 ] \
        || { echo "the git backport is only published for amd64" >&2; exit 1; } \
    && apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && cd /tmp \
    && curl -fsSL -o git.deb "${GIT_DEB_POOL}/git_${GIT_DEB_VERSION}_amd64.deb" \
    && curl -fsSL -o git-man.deb "${GIT_DEB_POOL}/git-man_${GIT_DEB_VERSION}_all.deb" \
    && printf '%s  %s\n' "${GIT_DEB_SHA256}" git.deb "${GIT_MAN_DEB_SHA256}" git-man.deb \
        | sha256sum -c - \
    && apt-get install -y --no-install-recommends ./git.deb ./git-man.deb \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/git.deb /tmp/git-man.deb \
    && git --version | grep -q '^git version 2\.53\.'

# -------------------------------------------------------------------
# feature: build
# -------------------------------------------------------------------
# make, cmake and ninja are carried by every firmware variant, including the
# ones that do not use them: a few tens of MB against the 1.2 GB toolchain,
# not worth a separate variant.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        wget \
        bzip2 \
        ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------------
# feature: python
# -------------------------------------------------------------------
# The system interpreter, for scripts that expect /usr/bin/python3. Project
# environments are uv's job, hence no pip and no pipenv here.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------------
# feature: uv
# -------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# wget, not curl: curl is only present in the dev variant. Piping the
# installer into sh would also hide a download failure, so download it, run
# it, then check that uv really is there.
RUN wget -qO /tmp/uv-install.sh https://astral.sh/uv/install.sh \
    && env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 \
        sh /tmp/uv-install.sh \
    && rm /tmp/uv-install.sh \
    && uv --version

# -------------------------------------------------------------------
# feature: arm-none-eabi
# -------------------------------------------------------------------
# The expensive layer, 1.2 GB. It must stay after every feature it shares
# with the other variants, otherwise it is stored once per variant.
ARG ARM_TOOLCHAIN_VERSION=15.3.rel1
ARG ARM_DL_LINK=https://gitlab.arm.com/api/v4/projects/tooling%2Fgnu-toolchains-for-arm/packages/generic/gnu-toolchain/${ARM_TOOLCHAIN_VERSION}/arm-gnu-toolchain-${ARM_TOOLCHAIN_VERSION}-x86_64-arm-none-eabi.tar.xz
ARG ARM_TOOLCHAIN_SHA256=563bebb2b97d53382b956d6ee1fe61e2cae26699901417234a37df505ef9b5fa

ENV ARM_TOOLCHAIN_DIR=/opt/gnu_arm/${ARM_TOOLCHAIN_VERSION}
ENV PATH=${ARM_TOOLCHAIN_DIR}/bin:$PATH
ENV AM_I_IN_A_DOCKER_CONTAINER=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        xz-utils \
        ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p ${ARM_TOOLCHAIN_DIR} /tmp/arm-toolchain \
    && wget -qO /tmp/arm-toolchain.tar.xz ${ARM_DL_LINK} \
    && echo "${ARM_TOOLCHAIN_SHA256}  /tmp/arm-toolchain.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/arm-toolchain.tar.xz -C /tmp/arm-toolchain --strip-components=1 \
    && mv /tmp/arm-toolchain/* ${ARM_TOOLCHAIN_DIR} \
    && rm -rf /tmp/arm-toolchain /tmp/arm-toolchain.tar.xz \
    && arm-none-eabi-gcc --version

ENV TOOLCHAIN_DEVCONTAINER_DIR=${ARM_TOOLCHAIN_DIR}

# -------------------------------------------------------------------
# provenance
# -------------------------------------------------------------------
# Kept last in every image: IMAGE_COMMIT changes at every build, and an ARG
# read by a RUN invalidates that layer and everything after it. Last means
# the only rebuilt layer is this one, a few bytes.
#
# Written to a file, not only to a LABEL: a job running inside the container
# can read a file, it cannot read the labels of its own image. This is what
# makes a floating tag traceable -- the log of a green run says exactly which
# commit to pin when that build has to be rolled back to.
#
# /etc/image-info, and the shape of os-release and machine-info: quoted
# KEY="value" lines, so the file is both readable with `cat` and sourceable
# with `. /etc/image-info`. Not /etc/*-release, which is the legacy
# distro-identification pile os-release was written to replace, and not
# os-release itself -- that is a symlink into /usr/lib owned by the base
# distribution, and appending to it means either editing the vendor's file or
# breaking the link.
#
# The keys are prefixed. A bare COMMIT= would collide with a local of whatever
# script sources this. IMAGE_ID and IMAGE_VERSION are avoided on purpose: they
# are os-release spec names with defined meanings, and borrowing them for
# something else is worse than not using them.
ARG IMAGE_COMMIT=unknown
# The commit's own date, RFC 3339, not the build time -- a build time would
# change on every rebuild and destroy the property IMAGE_COMMIT exists for.
# It is here because a hash has no order: it answers "which build is this",
# never "is this older than what I have pinned". The image tag carries the
# same date in its compact YYYYMMDD form, which is what makes two pins
# comparable by eye; this one is the full value, so that
# org.opencontainers.image.created below is what the OCI spec says it is.
ARG IMAGE_DATE=unknown
LABEL org.opencontainers.image.revision="$IMAGE_COMMIT"
LABEL org.opencontainers.image.created="$IMAGE_DATE"
RUN printf 'IMAGE_NAME="%s"\nIMAGE_VARIANT="%s"\nIMAGE_COMMIT="%s"\nIMAGE_DATE="%s"\n' \
        'fw-arm-none-eabi-15.3.rel1' 'base' "$IMAGE_COMMIT" "$IMAGE_DATE" \
        > /etc/image-info
